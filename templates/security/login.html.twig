{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="fr-grid-row fr-grid-row--center">
        <div class="fr-col-12 fr-col-md-6">
            <h1>Connexion</h1>

            {% if error %}
                <div class="fr-alert fr-alert--error fr-alert--sm fr-mb-3w">
                    <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                </div>
            {% endif %}

            <form method="post">
                <div class="fr-input-group">
                    <label class="fr-label" for="username">Adresse électronique</label>
                    <input class="fr-input" type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
                </div>
                <div class="fr-input-group">
                    <label class="fr-label" for="password">Mot de passe</label>
                    <input class="fr-input" type="password" id="password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="fr-btn" type="submit">Se connecter</button>
            </form>

            <div class="fr-callout fr-mt-4w">
                <p class="fr-callout__text">
                    Comptes de démonstration (mot de passe <code>motdepasse</code>) :<br>
                    agent@exemple.fr · agent2@exemple.fr · gestion@exemple.fr (gestionnaire)
                </p>
            </div>
        </div>
    </div>
{% endblock %}
