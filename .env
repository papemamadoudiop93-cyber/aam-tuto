# Variables par défaut, versionnées. Surcharger en local dans .env.local (jamais versionné).
APP_ENV=dev
APP_SECRET=change-me-en-local

# Par défaut : SQLite, aucune installation nécessaire.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# Pour s'entraîner sur PostgreSQL (comme à l'Académie) : `docker compose up -d` puis dans .env.local :
# DATABASE_URL="postgresql://app:app@127.0.0.1:5432/formations?serverVersion=16&charset=utf8"
